NODE_ENV=production
API_PORT=4000
POSTGRES_USER=lex
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=lex
DATABASE_URL=postgresql://lex:replace-with-a-long-random-database-password@postgres:5432/lex?schema=public
REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_URL=redis://:replace-with-a-long-random-redis-password@redis:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-different-random-characters
FIELD_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
LEX_DOMAIN=staging.example.com
ACME_EMAIL=security@example.com
PUBLIC_API_URL=https://staging.example.com/v1
NEXT_PUBLIC_API_URL=https://staging.example.com/v1
OPENAI_API_KEY=
OPENAI_INTAKE_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v24.0
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
S3_ENDPOINT=https://replace-with-private-object-storage-endpoint
S3_PUBLIC_ENDPOINT=https://replace-with-private-object-storage-endpoint
S3_REGION=eu-central
S3_BUCKET=lex-private
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Lex <no-reply@example.com>
DEV_OTP_ECHO=false
BACKUP_DIR=/var/backups/lex
BACKUP_AGE_RECIPIENT=
