{
  "name": "@lex/cloudflare-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "cf:types": "wrangler types",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply lex-staging-db --local",
    "db:seed:local": "wrangler d1 execute lex-staging-db --local --file seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply lex-staging-db --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.2",
    "@lex/contracts": "workspace:*",
    "@lex/d1": "workspace:*",
    "@lex/jurisdictions": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.10.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.11",
    "typescript": "~6.0.3",
    "vitest": "~3.2.4",
    "wrangler": "^4.0.0"
  }
}
